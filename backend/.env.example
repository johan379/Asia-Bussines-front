ENTORNO=desarrollo

# MySQL local:
DATABASE_URL=mysql+pymysql://root@localhost:3306/inventario
# Supabase/PostgreSQL (configurar en el hosting, nunca en el frontend):
# DATABASE_URL=postgresql+psycopg2://USUARIO:CONTRASENA@HOST:PUERTO/postgres?sslmode=require

SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ORIGENES_PERMITIDOS=http://localhost:5173,http://127.0.0.1:4173

RECEPCIONES_TEMPORALES_DIR=./.recepciones-temporales
RECEPCIONES_TEMPORALES_MINUTOS=60
MAX_ARCHIVO_RECEPCION_BYTES=15728640

# Habilitar solo si Redis está realmente disponible.
# REDIS_URL=redis://localhost:6379/0

# Monitoreo opcional de errores: https://sentry.io
# SENTRY_DSN=https://clave@o0.ingest.sentry.io/proyecto

# Asistente de IA — Groq (inferencia alojada, rápida, gratis dentro de su
# límite de uso). Consigue una API key en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
