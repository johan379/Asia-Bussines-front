# ============================================================================
# Variables de entorno — copiar a ".env" y ajustar valores reales.
# NUNCA subir el ".env" real al repositorio.
# ============================================================================

ENTORNO=desarrollo

# --- Base de datos ---
# Desarrollo local (MySQL):
DATABASE_URL=mysql+pymysql://root@localhost:3306/inventario

# Producción (Supabase / Postgres) — descomentar y usar al desplegar:
# DATABASE_URL=postgresql+psycopg2://usuario:password@db.xxxxx.supabase.co:5432/postgres

# --- Seguridad / JWT ---
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Directorio compartido y persistente para cargas temporales de recepcion.
# En produccion debe ser una ruta de volumen montado, no el disco efimero.
RECEPCIONES_TEMPORALES_DIR=/var/lib/inventario/recepciones-temporales
RECEPCIONES_TEMPORALES_MINUTOS=60

# --- CORS ---
ORIGENES_PERMITIDOS=http://localhost:5173,http://localhost:3000
